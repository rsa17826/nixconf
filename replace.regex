@name a
@file \.py$
@regex (?<=[^\s])  #
@replace  #
@endregex

@name trin ending spaces
@file 
@regex  +$
@replace 
@endregex

@name trin end lines
@file \.nix$
@regex ^\n+([}\]])
@replace $1
@endregex
@name trin start lines
@file \.nix$
@regex ([{[])\n{2,}
@replace $1

@endregex

@name no bin
@file \.sh$
@regex #!/bin/(\w+)
@replace #!/usr/bin/env $1
@endregex