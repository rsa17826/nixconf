{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "astal",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "astal/*": ["./.astal/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
