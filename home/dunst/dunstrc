#
# Dunst notification theme — "Void"
# The space between stars. One signal in the dark.
#
# Place at: ~/.config/dunst/dunstrc
#
# Color palette (mirrors void.rasi):
#   bg0       #03030a   abyss
#   bg2       #0d0d1e   surface
#   bg3       #12122c   raised
#   fg0       #c4cce8   primary text
#   fg1       #6a72a0   secondary text
#   fg2       #30324a   ghost
#   accent    #4d6fff   signal blue
#   accent-dim #2a3a8a  deep signal / borders
#   urgent    #9933cc   violet
#   active    #336688   teal

[global]
  ### Display ###
  monitor = 0
  follow = mouse

  ### Geometry ###
  width = (240, 400)
  height = (0, 160)
  origin = top-right
  offset = 16x16
  scale = 0
  notification_limit = 5

  ### Progress bar ###
  progress_bar = true
  progress_bar_height = 2
  progress_bar_frame_width = 0
  progress_bar_min_width = 150
  progress_bar_max_width = 360
  progress_bar_corner_radius = 0
  highlight = "#4d6fff"

  ### Appearance ###
  transparency = 10
  separator_height = 1
  padding = 12
  horizontal_padding = 14
  text_icon_padding = 10
  frame_width = 1
  frame_color = "#2a3a8a"
  gap_size = 6
  separator_color = frame
  sort = yes
  corner_radius = 6
  corners = all

  ### Text ###
  font = monospace 10
  line_height = 2
  markup = full
  format = "<b>%s</b>\n%b"
  alignment = left
  vertical_alignment = center
  show_age_threshold = 60
  ellipsize = middle
  ignore_newline = no
  stack_duplicates = true
  hide_duplicate_count = false
  show_indicators = no

  ### Icons ###
  enable_recursive_icon_lookup = true
  icon_theme = "Papirus-Dark, hicolor"
  icon_position = left
  min_icon_size = 0
  max_icon_size = 28
  icon_corner_radius = 3

  ### History ###
  sticky_history = yes
  history_length = 20

  ### Misc ###
  dmenu = /usr/bin/rofi -p dunst -dmenu
  browser = /usr/bin/xdg-open
  always_run_script = true
  title = Dunst
  class = Dunst
  ignore_dbusclose = false

  ### Mouse ###
  mouse_left_click = do_action, close_current
  mouse_middle_click = do_action, close_current
  mouse_right_click = close_all

  ### Wayland ###
  layer = overlay
  force_xwayland = false

[experimental]
  per_monitor_dpi = false

# ── Urgency: Low ────────────────────────────────────
# Dim, barely-there — background noise of the void
[urgency_low]
  background = "#03030a"
  foreground = "#6a72a0"
  frame_color = "#1e1e40"
  timeout = 4
  #icon = /path/to/icon

# ── Urgency: Normal ─────────────────────────────────
# The signal — clean, present, not alarming
[urgency_normal]
  background = "#0d0d1e"
  foreground = "#c4cce8"
  frame_color = "#2a3a8a"
  timeout = 6
  #icon = /path/to/icon

# ── Urgency: Critical ───────────────────────────────
# Violet tears through the dark — something demands attention
[urgency_critical]
  background = "#0d0d1e"
  foreground = "#c4cce8"
  frame_color = "#9933cc"
  highlight = "#9933cc"
  timeout = 20
  #icon = /path/to/icon
