@file scenes/blocks/([^/]+)/\1\.gd$
@regex func on_body_(entered|exited)\(body: Node2D, real=true\) -> void:
@replace func on_body_$1(body: Node2D) -> void:
@flags gm
@endregex

@file \.gd$
@regex body == global\.player
@replace body is Player
@flags gm
@endregex

