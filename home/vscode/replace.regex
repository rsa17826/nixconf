@name mo allowUnfree
@file \.nix$
@regex ^( *)(?<!\w)allowUnfree\s*=\s*true\s*;
@replace $1#FIXME dont use allowUnfree
$1allowUnfree = false;
@flags gm
@endregex

@name fix enter key
@file /hyprland\.conf$
@regex ENTER
@replace RETURN
@endregex

@name admin - ensure source= line exists
@file \.sh$
@regex ^(?!# shellcheck source=)([^\n]*)\n(\. admin[^\n]*)$
@replace $1
# shellcheck source=/etc/profiles/per-user/nyix/bin/admin
$2
@endregex

@name admin - ensure requiresSudo appended
@file \.sh$
@regex ^(\. admin)(?! && requiresSudo "\$@"$)[^\n]*$
@replace $1 && requiresSudo "$@"
@endregex

@name admin - fix wrong source= path
@file \.sh$
@regex ^# shellcheck source=(?!/etc/profiles/per-user/nyix/bin/admin$)[^\n]*$
@replace # shellcheck source=/etc/profiles/per-user/nyix/bin/admin
@endregex

@name admin - fix wrong source= path
@file \.sh$
@regex ^(?<!# shellcheck disable=SC1091\n)# shellcheck source=/etc/profiles/per-user/nyix/bin/admin$
@replace # shellcheck disable=SC1091
# shellcheck source=/etc/profiles/per-user/nyix/bin/admin
@endregex

@name fix wrong type cases
@file \.ts$
@regex : String( |$)
@replace : string$1
@endregex
@regex : Number( |$)
@replace : number$1
@endregex

@name hyprland no dupes
@file /hyprland\.conf$
@regex ^( *)([\w:]+) \{[\s\S]*?^\1(\2) \{
@error duplicated "$2" section detected on line !ln.3
@errgroup 2
@endregex

@name nix fix fake hash
@file \.nix$
@regex (?<=[\s])(?:pkgs\.)?lib\.fakeHash(?=[\s;])
@replace "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
@endregex

@name force real - char
@file (?<!\.regex)$
@regex \u2013
@replace -
@endregex
@regex \u2212
@replace -
@endregex

@name no interface{}
@file \.go$
@regex (?<!\w)interface\{\}(?!\w)
@replace any
@endregex

@name no . notation for assignment
@file \.nix$
@regex ^[^#]*?((?:[\w\d\-]|"[^\n"]+?")+)\.(?:(?:([\w\d\-]|"[^\n"]+?")+\.)*(?:[\w\d\-]|"[^\n"]+?")+)(?<!text|source|toLocaleString) =
@error using . notation for assignment
@errgroup 1
@endregex

@name no duplicate newlines between } and next }
@file \.nix$
@regex (\};? *?\n)\s+(^ *\};?)
@replace $1$2
@endregex

