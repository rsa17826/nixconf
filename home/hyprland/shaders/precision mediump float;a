precision mediump float;
varying vec2 v_texcoord;
uniform sampler2D tex;

// Adjust based on resolution (1.0 / height)
const float offset = 1.0 / 1080.0;

float get_lum(vec3 rgb) {
  return dot(rgb, vec3(0.299, 0.587, 0.114));
}

void main() {
  vec4 pixColor = texture2D(tex, v_texcoord);
  float lum = get_lum(pixColor.rgb);

  // CONFIGURATION
  float threshold = 0.5;
  float cap = 0.4;

  // Sample neighbors
  vec3 nU = texture2D(tex, v_texcoord + vec2(0.0, offset)).rgb;
  vec3 nD = texture2D(tex, v_texcoord + vec2(0.0, -offset)).rgb;
  vec3 nL = texture2D(tex, v_texcoord + vec2(-offset, 0.0)).rgb;
  vec3 nR = texture2D(tex, v_texcoord + vec2(offset, 0.0)).rgb;

  float maxN = max(max(get_lum(nU), get_lum(nD)), max(get_lum(nL), get_lum(nR)));

  // Logic: Only dim the pixel if it is actually bright OR if it is
  // extremely similar in color to a bright neighbor (the background).
  // This prevents "darkening" text edges that have a different hue/saturation.
  bool isBright = lum > threshold;
  bool isTouchingFlashbang = maxN > 0.95 && lum > 0.3;

  if (isBright || isTouchingFlashbang) {
    float effectiveLum = max(lum, maxN);
    float overshoot = (effectiveLum - threshold) / (1.0 - threshold);
    float newLum = threshold + (overshoot * (cap - threshold));

    pixColor.rgb *= (newLum / effectiveLum);
  }

  gl_FragColor = pixColor;
}
