precision mediump float;
varying vec2 v_texcoord;
uniform sampler2D tex;

// You may need to tweak this based on your resolution.
// 1.0 / 1080.0 is a good starting point for a 1080p screen.
const float offset = 1.0 / 1080.0;

float get_lum(vec3 rgb) {
  return dot(rgb, vec3(0.299, 0.587, 0.114));
}

void main() {
  vec4 pixColor = texture2D(tex, v_texcoord);
  float lum = get_lum(pixColor.rgb);

  // CONFIGURATION
  float threshold = 0.5;
  float cap = 0.4; // Lowered to 0.4 to make the dimming more obvious

  // Sample neighbors to check for nearby white pixels
  float lumU = get_lum(texture2D(tex, v_texcoord + vec2(0.0, offset)).rgb);
  float lumD = get_lum(texture2D(tex, v_texcoord + vec2(0.0, -offset)).rgb);
  float lumL = get_lum(texture2D(tex, v_texcoord + vec2(-offset, 0.0)).rgb);
  float lumR = get_lum(texture2D(tex, v_texcoord + vec2(offset, 0.0)).rgb);

  // Find the max brightness in the immediate neighborhood
  float maxNeighborLum = max(max(lumU, lumD), max(lumL, lumR));

  // EFFECT LOGIC:
  // If the pixel OR its neighbor is above the threshold, we dim it.
  // This "swallows" the anti-aliased edges into the dimmed area.
  float effectiveLum = max(lum, maxNeighborLum);

  if (effectiveLum > threshold) {
      float overshoot = (effectiveLum - threshold) / (1.0 - threshold);
      float newLum = threshold + (overshoot * (cap - threshold));

      // We scale the ORIGINAL pixel color by the ratio
      // derived from the brightest neighbor.
      pixColor.rgb *= (newLum / effectiveLum);
  }

  gl_FragColor = pixColor;
}